{
  "name": "fontbrowser",
  "productName": "fontbrowser",
  "version": "0.0.20",
  "description": "View and organize fonts",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "debug": "electron-forge start --vscode",
    "tailwind": "pnpm dlx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/index.css",
    "forge": "pnpm add -D @electron-forge/cli@latest @electron-forge/maker-deb@latest @electron-forge/maker-dmg@latest @electron-forge/maker-rpm@latest @electron-forge/maker-squirrel@latest @electron-forge/maker-zip@latest @electron-forge/plugin-webpack@latest @electron-forge/publisher-github@latest @electron-forge/shared-types@latest"
  },
  "keywords": [
    "fonts"
  ],
  "author": "nianeyna",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-webpack": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron-forge/shared-types": "^7.10.2",
    "@tailwindcss/cli": "^4.1.14",
    "@types/fontfaceobserver": "^2.1.3",
    "@types/fontkit": "^2.0.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "css-loader": "^7.1.2",
    "electron": "^38.2.2",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "node-loader": "^2.1.0",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.14",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "electron-context-menu": "^4.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "fontfaceobserver": "^2.3.0",
    "fontkit": "^2.0.4",
    "glob": "^11.1.0",
    "lorem-ipsum": "^2.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.12.0",
    "react-virtuoso": "^4.14.1",
    "slugify": "^1.6.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
